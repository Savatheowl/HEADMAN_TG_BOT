# Токен бота, полученный у @BotFather (обязательно)
BOT_TOKEN=ВАШ_ТОКЕН_ЗДЕСЬ

# Путь до файла SQLite
DATABASE_PATH=data/bot.db

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Интервал обновления данных в минутах
UPDATE_INTERVAL_MINUTES=60

# Каталог для скачанных файлов
DOWNLOAD_DIR=downloads

# Время жизни кэша в секундах
CACHE_TTL_SECONDS=3600

# Перевернуть соответствие «чётная неделя года — верхняя» (если у вас наоборот)
WEEK_PARITY_FLIP=false

# Telegram-id суперпользователей (через запятую/пробел). Им доступна админ-панель,
# они могут раздавать роли. Остальные роли назначаются через админ-панель.
ADMIN_IDS=